{
  "name": "pranapulse-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PranaPulse AI — Winter Smog, Indoor Clearance & Low-Emission Family Assistant for PromptWars Virtual Challenge 06",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.mjs",
    "start": "node --env-file-if-exists=.env dist-server/index.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"server/**/*.ts\" \"api/**/*.ts\" \"tests/**/*.{ts,tsx}\"",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:e2e": "npm run build && npm run build:server && playwright test",
    "check:dup": "npx jscpd src server api --threshold 0",
    "check:repo-size": "node scripts/check-repo-size.mjs",
    "verify:all": "npm run typecheck && npm run lint && npm run check:dup && npm run test:coverage && npm run build && npm run check:repo-size"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@google/genai": "^1.0.0",
    "@supabase/supabase-js": "^2.119.1",
    "compression": "^1.8.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.27.0",
    "@playwright/test": "^1.52.0",
    "@stryker-mutator/core": "^9.0.0",
    "@stryker-mutator/vitest-runner": "^9.0.0",
    "@tailwindcss/vite": "^4.1.7",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.5.0",
    "@vitest/coverage-v8": "^3.2.0",
    "axe-core": "^4.10.3",
    "eslint": "^9.27.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fast-check": "^4.1.1",
    "jscpd": "^4.0.5",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.3",
    "supertest": "^7.1.1",
    "tailwindcss": "^4.1.7",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.0"
  }
}
