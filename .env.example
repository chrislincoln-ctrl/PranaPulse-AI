# Required for live Gemini AI schedules & streaming explanations (falls back cleanly when omitted)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional Groq LLM automatic failover & second-opinion advisor (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Optional physical station & satellite fire cross-checks (graceful Open-Meteo + seasonal fallback when blank)
WAQI_API_TOKEN=
NASA_FIRMS_MAP_KEY=

# Server / Deployment configuration
NODE_ENV=development
PORT=8080
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Optional Supabase Auth & cloud workspace sync (public client credentials)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=


